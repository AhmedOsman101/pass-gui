#!/usr/bin/env bash

yesNo() {
  local answer prompt="$1"
  read -rp "${prompt} [Y/n] " answer

  [[ ! "${answer}" =~ ^[nN]$ ]]
}

abort() {
  printf "\e[31mAborting commit.\e[0m\n"
  exit 1
}

gitRoot="$(git rev-parse --show-toplevel)"

cd "${gitRoot}" || exit 1

# Get list of staged files (adds, copies, modified, renamed)
mapfile -t files < <(git diff --cached --name-only --diff-filter=ACMR)

((${#files[@]})) || exit 0

# Create temp directory for patches
tmpDir="$(mktemp -d)"
trap 'rm -rf $tmpDir' EXIT

# Save staged content as patches for each file
for file in "${files[@]}"; do
  if [[ -f "${file}" ]]; then
    git show ":0:${file}" >"${tmpDir}/${file}.staged" 2>/dev/null
  fi
done

# --- Formats only the staged files --- #
unset BIOME_BINARY &>/dev/null
unset BIOME_CONFIG_PATH &>/dev/null
pnpm exec biome check --fix --no-errors-on-unmatched --staged "${gitRoot}"

# Compare staged content with formatted content to find changed files
formatted_files=()
for file in "${files[@]}"; do
  stagedFile="${tmpDir}/${file}.staged"
  if [[ -f "${stagedFile}" && -f "${file}" ]]; then
    if ! diff -q "${stagedFile}" "${file}" &>/dev/null; then
      formatted_files+=("${file}")
    fi
  fi
done

# If no files were formatted, proceed without prompt
if ((${#formatted_files[@]} != 0)); then
  printf "\e[33m%d file(s) were formatted:\e[0m\n" ${#formatted_files[@]}
  for f in "${formatted_files[@]}"; do
    printf "  - %s\n" "${f}"
  done

  yesNo "\nDo you want to proceed with the commit?" || abort
fi

# --- Do type checking before any commit --- #
printf "\e[34mDoing type checks...\e[0m\n"
if ! pnpm --filter=client typecheck; then
  yesNo "Typechecking failed.\nDo you want to proceed with the commit?" || abort
fi

exit 0
