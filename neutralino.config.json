{
  "$schema": "https://raw.githubusercontent.com/neutralinojs/neutralinojs/main/schemas/neutralino.config.schema.json",
  "applicationId": "com.github.passgui",
  "applicationName": "Pass GUI",
  "author": "Ahmad Othman",
  "description": "User-friendly desktop GUI application for the GNU Pass password manager",
  "copyright": "Copyright (c) Ahmad Othman <ahmad.ali.othman@outlook.com> 2026. All rights reserved.",
  "applicationIcon": "client/dist/app_icon.png",
  "version": "0.0.1",
  "defaultMode": "window",
  "port": 0,
  "documentRoot": "/client/dist/",
  "url": "/",
  "enableServer": true,
  "logging": {
    "enabled": true,
    "writeToLogFile": true
  },
  "enableNativeAPI": true,
  "tokenSecurity": "one-time",
  "nativeAllowList": [
    "app.*",
    "os.*",
    "filesystem.*",
    "debug.*",
    "window.*",
    "events.*",
    "clipboard.*",
    "computer.*"
  ],
  "modes": {
    "window": {
      "title": "Password Store GUI",
      "width": 1400,
      "height": 800,
      "minWidth": 800,
      "minHeight": 600,
      "fullScreen": false,
      "alwaysOnTop": false,
      "enableInspector": true,
      "icon": "/client/dist/app_icon.png",
      "borderless": false,
      "maximize": true,
      "hidden": false,
      "resizable": true,
      "useSavedState": false,
      "exitProcessOnClose": true
    }
  },
  "cli": {
    "binaryName": "pass-gui",
    "distributionPath": "/build",
    "resourcesPath": "/client/dist/",
    "extensionsPath": "/extensions/",
    "binaryVersion": "6.5.0",
    "frontendLibrary": {
      "patchFile": "/client/index.html",
      "devUrl": "http://localhost:3000",
      "projectPath": "/client/",
      "initCommand": "pnpm install",
      "devCommand": "true",
      "buildCommand": "pnpm --filter=client build"
    }
  }
}
