{
  "name": "pass-gui",
  "author": "Ahmad Othman",
  "version": "0.0.1",
  "description": "GUI wrapper for GNU Pass (passowrd-store)",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "lint": "unset BIOME_CONFIG_PATH; biome lint .",
    "format": "unset BIOME_CONFIG_PATH; biome check --fix .",
    "format:unsafe": "unset BIOME_CONFIG_PATH; biome check --fix --unsafe .",
    "typecheck": "pnpm --filter=client typecheck",
    "dev:neutralino": "neu run dev",
    "dev:frontend": "pnpm --filter=client dev",
    "dev": "concurrently -n \"FRONTEND,NEUTRALINO\" -c \"blue,magenta\" \"pnpm dev:frontend\" \"pnpm dev:neutralino\"",
    "build:frontend": "pnpm --filter=client build",
    "build": "pnpm build:frontend && neu build",
    "build:clean": "pnpm clean && pnpm build",
    "release": "pnpm clean && pnpm build:frontend && neu build --release --clean",
    "clean": "rm -rf client/dist && rm -rf dist/*",
    "update:neu": "neu update"
  },
  "packageManager": "pnpm@11.9.0",
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "ignore": "^7.0.5",
    "lib-result": "^5.0.0",
    "@ltd/j-toml": "^1.38.0",
    "@lucide/vue": "^1.22.0",
    "@neutralinojs/lib": "^6.8.0",
    "pinia": "^3.0.4",
    "reka-ui": "^2.10.1",
    "shadcn-vue": "^2.7.4",
    "strip-ansi": "^7.1.2",
    "tailwind-merge": "^3.6.0",
    "vue": "^3.5.26",
    "vue-router": "^5.0.3",
    "@vueuse/core": "^14.2.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.0",
    "concurrently": "^9.2.1",
    "husky": "^9.1.7",
    "@iconify-json/radix-icons": "^1.2.6",
    "@iconify/vue": "^5.0.0",
    "npm-run-all2": "^8.0.4",
    "shadcn-vue": "^2.4.3",
    "tailwindcss": "^4.1.18",
    "@tailwindcss/vite": "^4.1.18",
    "@tsconfig/node24": "^24.0.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.3",
    "@types/node": "^24.10.7",
    "vite": "^8.0.16",
    "@vitejs/plugin-vue": "^6.0.3",
    "vite-plugin-neutralino": "^1.0.3",
    "vite-plugin-vue-devtools": "^8.0.5",
    "vue-tsc": "^3.2.6",
    "@vue/tsconfig": "^0.8.1"
  }
}
