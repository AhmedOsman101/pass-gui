{
  "name": "pass-gui",
  "author": "Ahmad Othman",
  "version": "0.0.1",
  "description": "GUI wrapper for GNU Pass (passowrd-store)",
  "license": "GPL-3.0-or-later",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n 'VITE,NEUTRALINO' -c 'blue,magenta' 'cd client && pnpm dev' 'neu run dev'",
    "format": "unset BIOME_CONFIG_PATH; biome check --fix .",
    "prepare": "husky",
    "typecheck": "cd client && pnpm typecheck",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "packageManager": "pnpm@11.17.0",
  "dependencies": {
    "@ltd/j-toml": "^1.38.0",
    "@lucide/vue": "^1.26.0",
    "@neutralinojs/lib": "github:AhmedOsman101/neutralino.js#pnpm",
    "@tanstack/vue-hotkeys": "^0.10.0",
    "@vueuse/core": "^14.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "ignore": "^7.0.6",
    "lib-result": "^6.0.0",
    "pinia": "^4.0.2",
    "reka-ui": "^2.10.1",
    "sonner": "^2.0.7",
    "strip-ansi": "^7.2.0",
    "tailwind-merge": "^3.6.0",
    "vue": "^3.5.40",
    "vue-router": "^5.2.0",
    "vue-sonner": "^2.0.9",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.5",
    "@iconify-json/radix-icons": "^1.2.6",
    "@iconify/vue": "^5.0.1",
    "@neutralinojs/neu": "^11.7.2",
    "@pinia/testing": "^2.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tsconfig/node24": "^24.0.4",
    "@types/node": "^26.1.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^4.1.10",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "^0.9.1",
    "concurrently": "^10.0.3",
    "happy-dom": "^20.11.1",
    "husky": "^9.1.7",
    "npm-run-all2": "^9.0.2",
    "shadcn-vue": "^2.8.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.3",
    "vite": "^8.1.5",
    "vite-plugin-neutralino": "^1.0.3",
    "vite-plugin-vue-devtools": "^8.1.5",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.8"
  },
  "workspaces": ["client"]
}
