{
  "name": "pass-gui",
  "author": "Ahmad Othman",
  "version": "0.0.1",
  "description": "GUI wrapper for GNU Pass (passowrd-store)",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "lint": "biome lint .",
    "format": "biome check --fix .",
    "format:unsafe": "biome check --fix --unsafe .",
    "typecheck": "./pnpm-client typecheck",
    "dev:neutralino": "neu run dev",
    "dev:frontend": "./pnpm-client dev",
    "dev": "concurrently -n \"FRONTEND,NEUTRALINO\" -c \"blue,magenta\" \"pnpm dev:frontend\" \"pnpm dev:neutralino\"",
    "build:frontend": "./pnpm-client build",
    "build": "pnpm build:frontend && neu build",
    "build:clean": "pnpm clean && pnpm build",
    "release": "pnpm clean && pnpm build:frontend && neu build --release --clean",
    "clean": "rm -rf client/dist dist/*",
    "update:neu": "neu update"
  },
  "packageManager": "pnpm@10.29.3",
  "devDependencies": {
    "@biomejs/biome": "2.3.11",
    "@iconify-json/radix-icons": "^1.2.6",
    "@iconify/vue": "^5.0.0",
    "concurrently": "^9.2.1",
    "husky": "^9.1.7",
    "shadcn-vue": "^2.4.3",
    "@tailwindcss/vite": "^4.1.18",
    "@tsconfig/node24": "^24.0.3",
    "@types/node": "^24.10.4",
    "@vitejs/plugin-vue": "^6.0.3",
    "@vue/tsconfig": "^0.8.1",
    "npm-run-all2": "^8.0.4",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.0",
    "vite-plugin-neutralino": "^1.0.3",
    "vite-plugin-vue-devtools": "^8.0.5",
    "vue-tsc": "^3.2.2"
  },
  "dependencies": {
    "@neutralinojs/lib": "^6.4.0",
    "@vueuse/core": "^14.2.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lib-result": "^3.2.2",
    "lucide-vue-next": "^0.562.0",
    "pinia": "^3.0.4",
    "reka-ui": "^2.8.0",
    "strip-ansi": "^7.1.2",
    "tailwind-merge": "^3.4.0", "vue": "^3.5.26", "vue-router": "^4.6.4"
  }
}
