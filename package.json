{
  "name": "pass-gui",
  "author": "Ahmad Othman",
  "version": "0.1.0",
  "description": "GUI wrapper for GNU Pass (passowrd-store)",
  "license": "GPL-3.0-or-later",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n 'VITE,NEUTRALINO' -c 'blue,magenta' 'cd client && pnpm dev' 'neu run dev'",
    "format": "unset BIOME_CONFIG_PATH; biome check --fix .",
    "prepare": "husky",
    "typecheck": "cd client && pnpm typecheck"
  },
  "packageManager": "pnpm@12.14.0",
  "dependencies": {
    "@ltd/j-toml": "^1.38.0",
    "@lucide/vue": "^1.61.0",
    "@neutralinojs/lib": "github:AhmedOsman101/neutralino.js#pnpm",
    "@tanstack/vue-hotkeys": "^0.10.0",
    "@vueuse/core": "^14.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "ignore": "^7.0.14",
    "lib-result": "^6.0.0",
    "pinia": "^4.1.0",
    "reka-ui": "^2.11.0",
    "sonner": "^2.0.8",
    "strip-ansi": "^7.2.0",
    "tailwind-merge": "^3.7.0",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0",
    "vue-sonner": "^2.0.9",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@iconify-json/radix-icons": "^1.2.6",
    "@iconify/vue": "^5.0.4",
    "@neutralinojs/neu": "^11.8.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tsconfig/node24": "^24.0.5",
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/tsconfig": "^0.9.1",
    "concurrently": "^10.0.6",
    "husky": "^9.1.7",
    "shadcn-vue": "^2.8.2",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.5",
    "vite-plugin-neutralino": "^1.0.3",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vue-tsc": "^3.3.13"
  },
  "workspaces": ["client"]
